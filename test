test('a transient read-only tool failure is replayed, a side-effecting one is not', async () => {
  const { ctx } = fakeContext();
  apply(ctx, baseConfig);

  let readCalls = 0;
  const readResult = await ctx.waterfall(
    'tools/execute',
    { name: 'web_fetch', callId: 'c1', arguments: {}, signal: new AbortController().signal },
    async () => {
      readCalls += 1;
      return readCalls === 1
        ? { isError: true, error: { message: 'fetch failed' }, content: [{ type: 'text', text: 'fetch failed' }] }
        : { isError: false, value: { ok: true }, content: [{ type: 'text', text: 'ok' }] };
    },
  );
  assert.equal(readCalls, 2);
  assert.equal(readResult.isError, false);

  let writeCalls = 0;
  const writeResult = await ctx.waterfall(
    'tools/execute',
    { name: 'pwsh', callId: 'c2', arguments: {}, signal: new AbortController().signal },
    async () => {
      writeCalls += 1;
      return { isError: true, error: { message: 'fetch failed' }, content: [] };
    },
  );
  assert.equal(writeCalls, 1, 'a side-effecting tool must never be replayed');
  assert.equal(writeResult.isError, true);
  ctx.disposeAll();
});

test('a thrown transport failure inside a tool dispatch is replayed', async () => {
  const { ctx } = fakeContext();
  apply(ctx, baseConfig);
  let calls = 0;
  const result = await ctx.waterfall(
    'tools/execute',
    { name: 'read', callId: 'c3', arguments: {}, signal: new AbortController().signal },
    async () => {
      calls += 1;
      if (calls === 1) throw new Error('socket hang up');
      return { isError: false, value: 'body', content: [] };
    },
  );
  assert.equal(calls, 2);
  assert.equal(result.value, 'body');
  ctx.disposeAll();
});

test('a failed browser carrier request becomes a retryable 503', async () => {
  const { ctx } = fakeContext();
  apply(ctx, baseConfig);
  const response = {
    headersSent: false,
    writableEnded: false,
    status: undefined,
    headers: undefined,
    writeHead(status, headers) {
      this.status = status;
      this.headers = headers;
    },
    end() {
      this.writableEnded = true;
    },
  };
  await ctx.waterfall('connection/request', { method: 'POST', url: '/api/x' }, response, async () => {
    throw new Error('ECONNRESET');
  });  assert.equal(response.status, 503);
  assert.equal(response.headers['retry-after'], '1');
  assert.equal(response.writableEnded, true);
  ctx.disposeAll();
});

test('a non-transport carrier failure still propagates', async () => {
  const { ctx } = fakeContext();
  apply(ctx, baseConfig);
  const response = { headersSent: false, writableEnded: false, writeHead() {}, end() {} };
  await assert.rejects(
