import assert from 'node:assert/strict';
import test from 'node:test';
import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, join } from 'node:path';
import { apply } from '../index.js';

/**
 * A minimal Cordis-shaped context: event buses, effects, optional services and
 * the two service properties the plugin reads. `waterfall` mirrors the real
 * dispatch (listeners run in order; a listener that returns a value wins).
 */
function fakeContext({ services = {}, logger = console } = {}) {
  const listeners = new Map();
  const disposers = [];
  const emitted = [];
  const appends = [];
  const ctx = {
    logger: { info() {}, warn() {}, error() {}, ...logger },
    on(event, listener, options) {
      const list = listeners.get(event) ?? [];
      list.push({ listener, options });
      listeners.set(event, list);
      return () => {};
    },
    emit(event, ...args) {
      emitted.push({ event, args });
      for (const { listener } of listeners.get(event) ?? []) listener(...args);
    },
    effect(factory, label) {
      const dispose = factory();
      if (typeof dispose === 'function') disposers.push({ dispose, label });
      return dispose;
    },
    inject(names, callback) {
      const present = {};
      let missing = false;
      for (const name of names) {
        if (services[name] === undefined) missing = true;
        else present[name] = services[name];
      }
      if (missing) return;
      const child = { ...ctx, ...present, inject: () => {}, effect: ctx.effect, on: ctx.on };
      const dispose = callback(child);
      if (typeof dispose === 'function') disposers.push({ dispose, label: `inject:${names.join(',')}` });
    },
    get(name) {
      return services[name];
    },
    /**
     * Mirror Cordis dispatch: `waterfall(event, ...args, next)` where the
     * listener receives the same `...args` plus its own `next` continuation.
     */
    async waterfall(event, ...args) {
      const next = args.pop();
      const list = (listeners.get(event) ?? []).map((entry) => entry.listener);
      let index = 0;
      const run = async () => {
        if (index >= list.length) return next();
        const listener = list[index++];
        return listener(...args, run);
      };
      return run();
    },
    disposeAll() {
      for (const { dispose } of disposers.splice(0)) dispose();
    },
  };
  for (const name of Object.keys(services)) if (ctx[name] === undefined) ctx[name] = services[name];
  return { ctx, listeners, emitted, appends };
}

function fakeAgent(sessionAppends) {
  return {
    id: 'agent-1',
    session: {
      append(type, data) {
        sessionAppends.push({ type, data });
        return { seq: sessionAppends.length };
      },
    },
  };
}

const baseConfig = { initialDelayMs: 1, maxDelayMs: 5, jitterRatio: 0, maxRetries: 2, maxToolRetries: 2 };

test('a transport model failure is repaired and retried with a recorded retry event', async () => {
  const { ctx, appends } = fakeContext();
  apply(ctx, baseConfig);
  const agent = fakeAgent(appends);
  const signal = new AbortController().signal;

  const decision = await ctx.waterfall(
    'agent/request-error',
    { agent, turn: 1, step: 1, provider: 'loomy', failure: { code: 'TRANSPORT', message: 'fetch failed' }, signal },
    async () => undefined,
  );

  assert.deepEqual(decision, { kind: 'retry' });
  const retry = appends.find((entry) => entry.type === 'llm/retry');
  assert.ok(retry, 'a durable llm/retry event must be appended');
  assert.equal(retry.data.provider, 'loomy');
  assert.equal(retry.data.retry, 1);
  assert.equal(retry.data.policyKey, 'request-doctor:transport');
  assert.ok(appends.some((entry) => entry.type === 'llm/retry-started'));
  ctx.disposeAll();
});

test('a provider policy that already retries keeps priority', async () => {
  const { ctx, appends } = fakeContext();
  apply(ctx, baseConfig);
  const agent = fakeAgent(appends);
  const signal = new AbortController().signal;

  const decision = await ctx.waterfall(
    'agent/request-error',
    { agent, turn: 1, step: 1, provider: 'p', failure: { code: 'TRANSPORT', message: 'fetch failed' }, signal },
    async () => ({ kind: 'retry' }),
  );

  assert.deepEqual(decision, { kind: 'retry' });
  assert.equal(appends.length, 0, 'request-doctor must not add a second retry chain');
  ctx.disposeAll();
});

test('provider-side and policy failures are left alone', async () => {
  const { ctx, appends } = fakeContext();
  apply(ctx, baseConfig);
  const agent = fakeAgent(appends);
  const signal = new AbortController().signal;

  for (const failure of [
    { code: 'QUOTA', message: 'insufficient quota' },
    { code: 'RATE_LIMIT', message: 'slow down' },
    { status: 403, message: 'blocked by content policy' },
  ]) {
    const decision = await ctx.waterfall(
      'agent/request-error',
      { agent, turn: 1, step: 1, provider: 'p', failure, signal },
      async () => undefined,
    );
    assert.equal(decision, undefined, JSON.stringify(failure));
  }
  assert.equal(appends.length, 0);
  ctx.disposeAll();
});

test('the retry budget is bounded per step', async () => {
  const { ctx, appends } = fakeContext();
  apply(ctx, { ...baseConfig, maxRetries: 2 });
  const agent = fakeAgent(appends);
  const signal = new AbortController().signal;
  const payload = { agent, turn: 1, step: 1, provider: 'p', failure: { code: 'TRANSPORT', message: 'fetch failed' }, signal };
  const next = async () => undefined;

  assert.deepEqual(await ctx.waterfall('agent/request-error', payload, next), { kind: 'retry' });
  assert.deepEqual(await ctx.waterfall('agent/request-error', payload, next), { kind: 'retry' });
  assert.equal(await ctx.waterfall('agent/request-error', payload, next), undefined, 'budget must run out');
  ctx.disposeAll();
});

test('an oversized context is compacted before retrying', async () => {
  const compacted = [];
  const pruned = [];
  const { ctx } = fakeContext({
    services: {
      compaction: { compactIfNeeded: async (agent, trigger) => compacted.push(trigger) },
      toolResultPruner: { pruneSession: (session) => pruned.push(session) },
    },
  });
  apply(ctx, baseConfig);
  const agent = fakeAgent([]);

  const decision = await ctx.waterfall(
    'agent/request-error',
    { agent, turn: 1, step: 1, provider: 'p', failure: { code: 'CONTEXT_WINDOW_EXCEEDED', message: 'too long' }, signal: new AbortController().signal },
    async () => undefined,
  );

  assert.deepEqual(decision, { kind: 'retry' });
  assert.deepEqual(compacted, ['context-overflow']);
  assert.equal(pruned.length, 1);
  ctx.disposeAll();
});

test('a missing adapter gives the blocked plugin its own compatible environment, then retries', async () => {
  // A real on-disk fixture: the profile carries the new runtime, the plugin was
  // built against an older one.
  const root = mkdtempSync(join(tmpdir(), 'request-doctor-'));
  const write = (rel, text) => {
    const path = join(root, rel);
    mkdirSync(dirname(path), { recursive: true });
    writeFileSync(path, text, 'utf8');
    return path;
  };
  write('package.json', '{"name":"profile"}');
  write('node_modules/fake-plugin/package.json', JSON.stringify({
    name: 'fake-plugin',
    version: '1.0.0',
    type: 'module',
    main: 'index.js',
    peerDependencies: { '@deepseek-ai/dsh-llm': '0.2.1-rc.2' },
  }));
  write('node_modules/fake-plugin/index.js', 'import { kept } from "@deepseek-ai/dsh-llm";\nexport const ok = kept;\n');
  write('node_modules/@deepseek-ai/dsh-llm/package.json', JSON.stringify({ name: '@deepseek-ai/dsh-llm', version: '0.2.1-rc.3', type: 'module', main: 'index.js' }));
  write('node_modules/@deepseek-ai/dsh-llm/index.js', 'export const kept = () => "kept";\nexport const other = () => "other";\n');

  const manager = {
    listBundles: async () => [
      {
        name: 'fake-plugin',
        error: {
          code: 'incompatible-version',
          incompatible: [{
            name: 'fake-plugin',
            version: '1.0.0',
            runtimeVersion: '0.2.1-rc.3',
            requirements: { '@deepseek-ai/dsh-llm': '0.2.1-rc.2' },
          }],
        },
      },
    ],
    listVersionExemptions: () => ({ exemptions: {} }),
    listPlugins: async () => [],
    setVersionExemption: async () => {
      throw new Error('the plugin must build a compatible environment, not bypass the check');
    },
    setBundleEnabled: async () => ({ application: 'applied' }),
  };
  const { ctx } = fakeContext({ services: { pluginManager: manager, profileContext: { dir: root } } });
  apply(ctx, { ...baseConfig, autoVersionRepair: true });
  const agent = fakeAgent([]);

  // Let the startup scan run (it is deferred so HMR can finish activating).
  await new Promise((resolve) => setTimeout(resolve, 1800));

  // The plugin now resolves its import to a nested environment that satisfies
  // the runtime's version check...
  const envManifest = JSON.parse(readFileSync(join(root, 'node_modules/fake-plugin/node_modules/@deepseek-ai/dsh-llm/package.json'), 'utf8'));
  assert.equal(envManifest.version, '0.2.1-rc.3');
  // ...and its own declaration is aligned, because DSH reads that manifest
  // before any import happens. The vendor copy is preserved for reversal.
  const own = JSON.parse(readFileSync(join(root, 'node_modules/fake-plugin/package.json'), 'utf8'));
  assert.equal(own.peerDependencies['@deepseek-ai/dsh-llm'], '0.2.1-rc.3');
  assert.ok(existsSync(join(root, 'node_modules/fake-plugin/package.json.request-doctor-original')));

  const decision = await ctx.waterfall(
    'agent/request-error',
    { agent, turn: 1, step: 1, provider: 'p', failure: { code: 'NO_ADAPTER', message: 'no adapter' }, signal: new AbortController().signal },
    async () => undefined,
  );
  assert.deepEqual(decision, { kind: 'retry' });
  ctx.disposeAll();
  rmSync(root, { recursive: true, force: true });
});

