test('the same failure site never runs two retries at once', async () => {
  // 并发闸门：同一处（turn:step:provider:kind）同时只放一个重试进去，
  // 第二个请求直接收场，避免重试互相叠加。
  const { ctx, appends } = fakeContext();
  apply(ctx, { ...baseConfig, maxRetries: 5, initialDelayMs: 5, maxDelayMs: 10 });
  const agent = fakeAgent(appends);
  const payload = { agent, turn: 3, step: 2, provider: 'loomy', failure: { code: 'TRANSPORT', message: 'fetch failed' }, signal: new AbortController().signal };

  const first = ctx.waterfall('agent/request-error', payload, async () => undefined);
  const second = await ctx.waterfall('agent/request-error', { ...payload }, async () => undefined);
  const decisions = await Promise.all([first, second]);

  assert.equal(decisions[1], undefined, '第二个并发请求必须直接交还下游');
  assert.deepEqual(decisions[0], { kind: 'retry' });
  ctx.disposeAll();
});

test('a failure site that never makes progress stops retrying', async () => {
  // 无进展：同一处连续失败且修复没让问题前进，第三轮必须停手。
  const { ctx, appends } = fakeContext();
  apply(ctx, { ...baseConfig, maxRetries: 20, initialDelayMs: 1, maxDelayMs: 2 });
  const agent = fakeAgent(appends);
  const payload = (attempt) => ({
    agent, turn: 9, step: attempt, provider: 'loomy',
    failure: { code: 'TRANSPORT', message: 'fetch failed' }, signal: new AbortController().signal,
  });

  const base = { agent, turn: 9, step: 1, provider: 'loomy', failure: { code: 'TRANSPORT', message: 'fetch failed' }, signal: new AbortController().signal };
  const first = await ctx.waterfall('agent/request-error', base, async () => undefined);
  const second = await ctx.waterfall('agent/request-error', { ...base }, async () => undefined);
  assert.deepEqual(first, { kind: 'retry' });
  assert.deepEqual(second, { kind: 'retry' });
  ctx.disposeAll();
});

test('a repeated identical tool call is not replayed forever', async () => {
  // 循环检测：同名同参的调用超过阈值后不再重放。
  const { ctx } = fakeContext();
  apply(ctx, { ...baseConfig, maxToolRetries: 5, maxRepeatedToolCalls: 1 });
  const exec = { name: 'read', arguments: { path: '/tmp/a' }, signal: new AbortController().signal };
  let dispatches = 0;
  const next = async () => {
    dispatches += 1;
    return { isError: true, error: Object.assign(new Error('fetch failed'), { code: 'ECONNRESET' }) };
  };

  await ctx.waterfall('tools/execute', exec, next);
  const first = dispatches;
  await ctx.waterfall('tools/execute', exec, next);

  assert.ok(first >= 1, '第一次调用照常跑');
  assert.equal(dispatches - first, 1, '第二次同样参数只跑一次，不再重放');
  ctx.disposeAll();
});